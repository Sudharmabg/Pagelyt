# Copy to .env.local for local development. Leave the Supabase values empty to use the in-memory store.

# --- Supabase (Project settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
# Server only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (optional, recommended in production) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Google PageSpeed Insights (enables Core Web Vitals; free key from Google Cloud) ---
PAGESPEED_API_KEY=

# --- Scheduled scans and uptime (used by the internal endpoints; the cron Worker is removed for now) ---
CRON_SECRET=

# --- Score-drop alert emails (Resend; optional) ---
RESEND_API_KEY=
ALERT_FROM=Pagelyt <alerts@pagelyt.dev>

# --- OpenAI: AI visibility (ChatGPT), Pagelyt Assistant and Analytics AI insights (server secret) ---
OPENAI_API_KEY=
# Optional model overrides: AI visibility checks (default gpt-4.1-mini) and the assistant + Analytics insights (default gpt-5)
OPENAI_MODEL=
OPENAI_CHAT_MODEL=

# --- Google integrations (server secrets; see DEPLOY.md, Google integrations) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any random string of 32+ characters. Encrypts stored refresh tokens: never change it once people have connected.
GOOGLE_TOKEN_KEY=
# Optional: only if the callback isn't <site origin>/api/google/callback
GOOGLE_REDIRECT_URI=
# Google Ads needs no key of its own: enable the Google Ads API in the same Cloud project and get Explorer access.
# Optional: pin a Google Ads API version (default v26)
GOOGLE_ADS_API_VERSION=

# --- Plans ---
# Until Razorpay billing exists, set to 1 to unlock white-label and AI visibility for every signed-in user.
PAGELYT_OPEN_FEATURES=

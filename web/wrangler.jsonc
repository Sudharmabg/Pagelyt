{
  // Cloudflare deployment for the web app (Next.js through OpenNext). Cloudflare now recommends
  // Workers with static assets for Next.js; it deploys from Git ("Workers Builds") the same way
  // Pages does. Secrets (never put these here): set with `wrangler secret put` or the dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pagelyt",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  // global_fetch_strictly_public makes every fetch() refuse private and internal addresses,
  // which is our SSRF backstop for scanning user-supplied URLs.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Cloudflare Browser Rendering, for server-rendered PDF reports (needs the Workers Paid plan).
  "browser": { "binding": "BROWSER" },
  // All variables and secrets live in the Cloudflare dashboard (Settings > Variables and secrets, plus the
  // Build variables for NEXT_PUBLIC_* values, which are baked in at build time). keep_vars stops a deploy from
  // wiping the dashboard values. See .env.example for the full list.
  "keep_vars": true
}

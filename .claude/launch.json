{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pagelyt-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "pagelyt-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:mock",
        "--prefix",
        "web"
      ],
      "env": {
        "PORT": "3100",
        "MOCK_PLAN": "professional"
      },
      "port": 3100
    }
  ]
}
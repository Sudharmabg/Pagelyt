{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pagelyt-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "pagelyt-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:mock",
        "--prefix",
        "web"
      ],
      "env": {
        "PORT": "3100",
        "MOCK_PLAN": "professional",
        "MOCK_ADMIN_EMAILS": "admin@example.test"
      },
      "port": 3100
    },
    {
      "name": "pagelyt-admin-test",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:mock",
        "--prefix",
        "web"
      ],
      "env": {
        "PORT": "3200",
        "MOCK_PORT": "54322",
        "NEXT_DIST_DIR": ".next-test",
        "MOCK_PLAN": "professional",
        "MOCK_ADMIN_EMAILS": "admin@example.test"
      },
      "port": 3200
    },
    {
      "name": "pagelyt-auth-test",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:mock",
        "--prefix",
        "web"
      ],
      "env": {
        "PORT": "3300",
        "MOCK_PORT": "54323",
        "NEXT_DIST_DIR": ".next-auth",
        "MOCK_CONFIRM": "on",
        "MOCK_PLAN": "professional"
      },
      "port": 3300
    },
    {
      "name": "pagelyt-share-test",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:mock",
        "--prefix",
        "web"
      ],
      "env": {
        "PORT": "3400",
        "MOCK_PORT": "54324",
        "NEXT_DIST_DIR": ".next-share",
        "MOCK_PLAN": "business",
        "EMAILS_ON": "1"
      },
      "port": 3400
    }
  ]
}
